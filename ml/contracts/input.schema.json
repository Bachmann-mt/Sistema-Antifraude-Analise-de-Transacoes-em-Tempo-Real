    "V7": {"type": "number"},
    "V8": {"type": "number"},
    "V9": {"type": "number"},
    "V10": {"type": "number"},
    "V11": {"type": "number"},
    "V12": {"type": "number"},
    "V13": {"type": "number"},
    "V14": {"type": "number"},
    "V15": {"type": "number"},
    "V16": {"type": "number"},
    "V17": {"type": "number"},
    "V18": {"type": "number"},
    "V19": {"type": "number"},
    "V20": {"type": "number"},
    "V21": {"type": "number"},
    "V22": {"type": "number"},
    "V23": {"type": "number"},
    "V24": {"type": "number"},
    "V25": {"type": "number"},
    "V26": {"type": "number"},
    "V27": {"type": "number"},
    "V28": {"type": "number"},
    "Amount": {
      "type": "number",
      "minimum": 0,
      "description": "Valor da transação na escala do dataset; deve ser finito no runtime."
    }
  }
}
